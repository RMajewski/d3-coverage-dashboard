{
  "name": "d3-coverage-dashboard",
  "version": "1.0.0",
  "description": "A D3.js-based interactive dashboard that visualizes test coverage data from V8 (Node.js) reports. It provides insights into feature files, test scenarios, executed and missing steps, and highlights source files that are only invoked versus actively tested. Built with TypeScript, Vite, and semantic-release for automated versioning.",
  "author": "René Majewski <rene.majewski@gmx.de>",
  "license": "MIT",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": "^20.18.0"
  },
  "keywords": [],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "add:license-headers": "node scripts/insert-license-header.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm lint --fix",
    "preview": "vite preview",
    "release": "semantic-release",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.2",
    "@semantic-release/npm": "^12.0.1",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "eslint": "^9.26.0",
    "eslint-plugin-sonarjs": "^3.0.2",
    "semantic-release": "^24.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  }
}